# Use this file when proxy.golang.org or golang.org/go.googlesource.com is blocked.
# Point GOPROXY at a module proxy you can reach, for example:
#
# docker build . -f Dockerfile.github --build-arg GOPROXY=https://goproxy.io,direct -t ochinchina/supervisord:latest
#
FROM golang:1.27.3-alpine AS builder

ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

COPY . /src
WORKDIR /src

RUN CGO_ENABLED=0 GOOS=linux go build -a -tags release -ldflags "-s -w" -o /usr/local/bin/supervisord .

FROM scratch

COPY --from=builder /usr/local/bin/supervisord /usr/local/bin/supervisord

ENTRYPOINT ["/usr/local/bin/supervisord"]
